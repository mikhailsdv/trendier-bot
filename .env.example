# Copy to .env and fill in. Real environment variables override these values.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Request log of both the bot and the skill (was MYSQLI_TABLE)
DB_TABLE=
# Private Alice skill links handed out by /alice
DB_ALICE_TABLE=trendier_bot_alice

# secret_token passed to setWebhook; when set, requests without it are rejected
TELEGRAM_SECRET=
